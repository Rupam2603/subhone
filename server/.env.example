# Copy to .env and fill in real values. Never put real secrets in this file —
# it is committed, and tests/setup.js loads it deliberately so the suite never
# depends on a developer's personal .env.

PORT=5000

# Local development default. For MongoDB Atlas use the srv form and ALWAYS name the
# database explicitly, or the driver silently connects to "test":
#   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/subhone?retryWrites=true&w=majority
# URL-encode the password if it contains @ : / ? # [ ] or %.
MONGODB_URI=mongodb://127.0.0.1:27017/subhone

# Must be at least 32 characters — config/env.js rejects anything shorter.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string_in_production

# Must be at least 16 characters. Peppers the OTP hashes, so changing it
# invalidates every outstanding challenge.
OTP_PEPPER=replace_this_with_a_long_random_string_in_production

CORS_ORIGIN=http://localhost:5173
SMS_PROVIDER=dev
GUEST_CART_TTL_DAYS=30

# Used only by `npm run seed` to create the first admin account.
SEED_ADMIN_EMAIL=admin@subhone.local
SEED_ADMIN_PASSWORD=replace_this_before_seeding
